# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic console -> API keys. Server-side only: never prefix this NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# --- Weekly funder-page watcher (optional) ---------------------------------
# Only needed if you schedule .github/workflows/watch.yml. See README.

# Shared secret between the GitHub Actions workflow and /api/cron/scan.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# The machine account the watcher signs in as. It is a normal Supabase user
# with NO membership — it is registered in `watch_agents` instead, which lets it
# read the opportunity list and write page-check results and nothing else.
# Server-side only: never prefix either of these NEXT_PUBLIC_.
WATCH_AGENT_EMAIL=
WATCH_AGENT_PASSWORD=
